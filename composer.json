{
    "name": "p3s/php-ytdlp-wrapper",
    "description": "Robust PHP 8.2 yt-dlp wrapper with Symfony 7 bundle integration",
    "keywords": [
        "php",
        "yt-dlp",
        "youtube",
        "symfony",
        "bundle",
        "download"
    ],
    "homepage": "https://github.com/p3s/php-ytdlp-wrapper",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/p3s/php-ytdlp-wrapper/issues",
        "source": "https://github.com/p3s/php-ytdlp-wrapper"
    },
    "require": {
        "php": "^8.2",
        "symfony/process": "^7.0",
        "symfony/config": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/http-kernel": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "P3s\\YtDlp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "P3s\\YtDlp\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "peckphp/peck": "^0.2.0",
        "phpstan/phpstan": "^2.1",
        "vimeo/psalm": "^6.15",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "scripts": {
        "test": "phpunit"
    },
    "suggest": {
        "symfony/framework-bundle": "Required for full Symfony bundle integration"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
